{
  "schemaVersion": 1,
  "id": "shama-addon",
  "version": "${version}",
  "name": "Shama addon",
  "description": "A Meteor Client addon built around finding what other people have hidden: bases, stashes, farms and players, with combat, movement and utility modules alongside.",
  "authors": [
    "Eabusham2"
  ],
  "contact": {},
  "license": "GPL-3.0-or-later",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "shama.addon.ShamaAddon"
    ],
    "preLaunch": [
      "shama.addon.LogCleaner"
    ],
    "modmenu": [
      "shama.addon.ShamaModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=${mc_version}",
    "java": ">=21",
    "meteor-client": "*"
  },
  "mixins": [
    "shama-addon.mixins.json",
    "shama-addon.baritone.mixins.json",
    "shama-addon.optional.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "7,255,220"
  }
}